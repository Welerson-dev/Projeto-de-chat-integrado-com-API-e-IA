# ===== DBS TELECOM — Chatbot MVP =====
# Copie para .env e preencha. NUNCA commite o .env.

# --- Servidor ---
PORT=3000

# --- App (token público do app; não dá acesso a dados da IXC) ---
APP_TOKEN=app_token_dbs_2026

# --- IXC (WebService demo) ---
# URL base SEM /webservice/v1 no final
IXC_URL=https://demo.ixcsoft.com.br
# Token único do ambiente demo — NÃO REGENERAR no painel (invalidaria o atual)
IXC_TOKEN=TOKEN_DO_AMBIENTE_DEMO_AQUI

# --- Gemini (IA) ---
GEMINI_API_KEY=CHAVE_GEMINI_AQUI
# gemini-2.0-flash foi aposentado pelo Google; use o modelo atual.
# Confira sempre o erro 404 da API, que indica o substituto vigente.
GEMINI_MODEL=gemini-3.6-flash

# --- Horário de atendentes (mensagem de plantonista fora do horário) ---
SUPPORT_START_HOUR=8
SUPPORT_END_HOUR=18
